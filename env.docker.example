# AI Configuration for Docker & Lighter Models
# Copy these values to your .env or .env.local file

# 1. Use Ollama running in Docker
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# 2. Use Lighter Models (Faster, less RAM)
# Text Generation: llama3.2 (3B parameters)
OLLAMA_MODEL_TEXT=llama3.2

# Embeddings: nomic-embed-text (Efficient)
OLLAMA_MODEL_EMBED=nomic-embed-text
